# ==============================================================================
# PayGuard Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local keys.
# NEVER commit your actual .env file to Git.

# Alchemy Base Mainnet API Key (Required for Base Mainnet wallet portfolio indexing)
# Get a free key at https://dashboard.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here

# GoPlus Security API Key (Optional: GoPlus provides public tier without key)
GOPLUS_API_KEY=

# Google Web Risk API Key (Optional: for enhanced phishing intelligence)
GOOGLE_WEB_RISK_API_KEY=

# Server Network Configuration
PORT=8080
HOST=0.0.0.0

