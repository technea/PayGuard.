{
  "name": "payguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, Base-first ecosystem security platform - phishing detection, token security, address screening, and calldata inspection for users and AI agents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "payguard": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs",
      "default": "./dist/plugin.mjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.mjs",
      "default": "./dist/agent/index.mjs"
    }
  },
  "files": [
    "dist",
    "index.js",
    "index.cjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "npm run build:css && node scripts/build.mjs",
    "demo": "node examples/url-sentinel-demo.mjs",
    "start": "node server.mjs",
    "build:css": "node scripts/build-tailwind.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@x402/core": "2.29.0"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.4.0"
  }
}
