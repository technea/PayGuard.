{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server.mjs",
          "paybox.mjs",
          "src/**",
          "public/**",
          "scripts/**",
          "docs/**",
          "README.md"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.mjs"
    }
  ],
  "buildCommand": "npm run build"
}
